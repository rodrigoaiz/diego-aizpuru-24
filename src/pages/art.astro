---
interface Art {
  name: string;
  technique: string;
  image: string;
  thumbnail: string;
  id: number;
}
import Layout from '@/layouts/Layout.astro';
import { art, sections } from "@art";
import { getShopItemConfig } from "@/config/shop";
function getSectionNameByCurrentUrl(): string | undefined {
  const { pathname } = Astro.url
  const currentUrl = pathname;
  const section = sections.find(section => section.url === currentUrl);
  return section ? section.name : undefined;
}
const sectionTitle = getSectionNameByCurrentUrl();
---
<Layout title={sectionTitle}>
  <div class="max-w-screen-lg mx-auto px-1">
    <h2 class="text-3xl my-5 uppercase">{sectionTitle}</h2>
    <div class="grid grid-cols-2 xl:grid-cols-3 gap-5">
      {art.map((item) => {
        const shopItem = getShopItemConfig(item.id);
        const isSold =
          shopItem?.status === 'sold' ||
          item.price.toLowerCase().includes('colección privada') ||
          item.price.toLowerCase().includes('coleccion privada');
        const canBuyDirect = shopItem?.enabled && !isSold;

        return (
          <a href={"/art/" + item.id.toString()}>
            <article class="col-span-1 aspect-auto animate-fade">
              <header class="relative">
                <img class="ease-in-out duration-200" src={item.thumbnail} alt={item.name} />
                {isSold && (
                  <span class="absolute top-2 left-2 bg-slate-800/90 text-white text-[11px] tracking-wide px-2 py-1 uppercase">
                    Vendido
                  </span>
                )}
                {canBuyDirect && (
                  <span class="absolute top-2 left-2 bg-black/80 text-white text-[11px] tracking-wide px-2 py-1 uppercase">
                    Compra directa
                  </span>
                )}
              </header>
              <footer class="self-end">
                <h3 class="font-light text-center text-base mt-1">{item.name}</h3>
              </footer>
            </article>
          </a>
        );
      })}
    </div>
  </div>
</Layout>
